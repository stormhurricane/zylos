<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LehrenderLogin">
    <children>
        <Text layoutX="14.0" layoutY="210.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Passwort">
            <font>
                <Font size="25.0" />
            </font>
        </Text>
        <TextField fx:id="Email" layoutX="221.0" layoutY="50.0">
            <font>
                <Font size="25.0" />
            </font>
        </TextField>
        <PasswordField fx:id="password" layoutX="221.0" layoutY="174.0">
            <font>
                <Font size="25.0" />
            </font>
        </PasswordField>
        <Button layoutX="241.0" layoutY="327.0" mnemonicParsing="false" onAction="#auslesen" text="Bestätigen">
            <font>
                <Font size="20.0" />
            </font>
        </Button>
        <Label fx:id="datenFehler" layoutX="10.0" layoutY="265.0" text="E-Mail oder Passwort sind falsch. Bitte gib die Daten erneut ein." visible="false" />
      <Text layoutX="42.0" layoutY="86.0" strokeType="OUTSIDE" strokeWidth="0.0" text="E-Mail">
         <font>
            <Font size="25.0" />
         </font>
      </Text>
        <Button layoutX="520.0" layoutY="12.0" mnemonicParsing="false" onAction="#changeToLaunchSeite" text="Startseite" />
    </children>
</AnchorPane>
