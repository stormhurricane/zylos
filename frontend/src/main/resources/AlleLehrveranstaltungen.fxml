<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AlleLehrveranstaltungen">
   <children>
      <ListView fx:id="AlleLehrveranstaltungenAnzeigen" layoutX="34.0" layoutY="169.0" prefHeight="200.0" prefWidth="545.0" />
      <Button fx:id="Beitreten" layoutX="34.0" layoutY="75.0" mnemonicParsing="false" onAction="#Beitreten" text="Beitreten" />
      <Button fx:id="LehrveranstaltungAnzeigen" layoutX="34.0" layoutY="112.0" mnemonicParsing="false" onAction="#LehrveranstaltungAnzeigen" text="Lehrveranstaltung anzeigen" />
      <Button layoutX="520.0" layoutY="12.0" mnemonicParsing="false" onAction="#changeToStartseite" text="Startseite" />
      <Label fx:id="FehlerAnzeigen" layoutX="301.0" layoutY="143.0" text="Es konnte keine Verbindung hergestellt werden" visible="false" />
      <Label fx:id="FehlerBeitreten" layoutX="147.0" layoutY="79.0" text="Beitritt fehlgeschlagen. Keine Verbindung möglich oder schon beigetreten." visible="false" />
      <Label fx:id="privat" layoutX="121.0" layoutY="56.0" prefHeight="47.0" prefWidth="447.0" text="Diese Veranstaltung ist leider privat." visible="false" wrapText="true" />
   </children>
</AnchorPane>
