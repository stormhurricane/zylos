<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MeineLehrveranstaltungen">
    <children>
        <ListView fx:id="AlleLehrveranstaltungenAnzeigen" layoutX="34.0" layoutY="169.0" prefHeight="200.0" prefWidth="545.0" />
        <Button fx:id="LehrveranstaltungAnzeigen" layoutX="34.0" layoutY="112.0" mnemonicParsing="false" onAction="#LehrveranstaltungAnzeigen" text="Lehrveranstaltung anzeigen" />
        <Button layoutX="520.0" layoutY="12.0" mnemonicParsing="false" onAction="#changeToStartseite" text="Startseite" />
        <Label fx:id="FehlerAnzeigen" layoutX="301.0" layoutY="143.0" text="Es konnte keine Verbindung hergestellt werden" visible="false" />
    </children>
</AnchorPane>
