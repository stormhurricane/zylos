<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="DatumEinstellen">
    <children>
        <Button layoutX="520.0" layoutY="14.0" mnemonicParsing="false" onAction="#changeToLaunchSeite" text="Startseite" />
        <DatePicker fx:id="datum" layoutX="175.0" layoutY="58.0" />
        <Text layoutX="49.0" layoutY="75.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Datum" />
      <Text layoutX="48.0" layoutY="149.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Uhrzeit (z.B 00:00)" />
      <TextField fx:id="zeit" layoutX="175.0" layoutY="132.0" prefHeight="25.0" prefWidth="170.0" />
      <Button layoutX="91.0" layoutY="293.0" mnemonicParsing="false" onAction="#datumAendern" text="Datum ändern" />
      <Button layoutX="345.0" layoutY="293.0" mnemonicParsing="false" onAction="#datumZuruecksetzen" text="Datum zurücksetzen" />
      <Label fx:id="fehler" layoutX="138.0" layoutY="183.0" text="Bitte prüfen Sie ob alle Angaben korrekt sind" visible="false" />
    </children>
</AnchorPane>
